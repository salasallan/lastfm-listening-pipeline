ists can share album names.\nselect\n    cast(played_at_local as date) as play_date,\n    artist,\n    album,\n    count(*) as plays\nfrom \"lastfm\".\"main\".\"stg_plays\"\nwhere album is not null\ngroup by 1, 2, 3", "relation_name": "\"lastfm\".\"main\".\"mart_album_daily\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-13T06:01:54.845979Z", "completed_at": "2026-11-13T06:01:54.848299Z"}, {"name": "execute", "started_at": "2026-11-13T06:01:54.848720Z", "completed_at": "2026-11-13T06:01:54.983644Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.13904666900634766, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.lastfm_pipeline.mart_track_daily", "compiled": true, "compiled_code": "-- Plays per artist + track per day.\nselect\n    cast(played_at_local as date) as play_date,\n    artist,\n    track,\n    count(*) as plays\nfrom \"lastfm\".\"main\".\"stg_plays\"\ngroup by 1, 2, 3", "relation_name": "\"lastfm\".\"main\".\"mart_track_daily\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-13T06:01:54.987871Z", "completed_at": "2026-11-13T06:01:54.991134Z"}, {"name": "execute", "started_at": "2026-11-13T06:01:54.991571Z", "completed_at": "2026-11-13T06:01:55.098861Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.1123197078704834, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.lastfm_pipeline.dim_artist_genre", "compiled": true, "compiled_code": "-- One row per artist with a single genre: the highest-weighted tag that appears in genre_mapping.\n-- 'unknown' = no tags at all; 'other' = has tags, but none is in the mapping.\nwith artists as (\n    select distinct artist\n    from \"lastfm\".\"main\".\"raw_scrobbles\"\n),\n\nartists_with_tags as (\n    select distinct artist\n    from \"lastfm\".\"main\".\"stg_artist_tags\"\n),\n\nmapped_tags as (\n    select\n        t.artist,\n        m.genre,\n        m.genre_family,\n        row_number() over (\n            partition by t.artist\n            order by t.tag_count desc, m.genre\n        ) as rn\n    from \"lastfm\".\"main\".\"stg_artist_tags\" t\n    join \"lastfm\".\"main\".\"genre_mapping\" m\n        on t.tag = lower(m.tag)\n)\n\nselect\n    a.artist,\n    case\n        when b.genre is not null then b.genre\n        when w.artist is not null then 'other'\n        else 'unknown'\n    end as genre,\n    case\n        when b.genre_family is not null then b.genre_family\n        when w.artist is not null then 'Other'\n        else 'Unknown'\n    end as genre_family\nfrom artists a\nleft join (select * from mapped_tags where rn = 1) b on b.artist = a.artist\nleft join artists_with_tags w on w.artist = a.artist", "relation_name": "\"lastfm\".\"main\".\"dim_artist_genre\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-13T06:01:55.103353Z", "completed_at": "2026-11-13T06:01:55.105820Z"}, {"name": "execute", "started_at": "2026-11-13T06:01:55.106215Z", "completed_at": "2026-11-13T06:01:55.118260Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.01680588722229004, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.lastfm_pipeline.dim_artist_genre_covers_all_artists", "compiled": true, "compiled_code": "-- Fails if the dimension has a different number of artists than raw_scrobbles.\nselect raw_artists, dim_artists\nfrom (\n    select\n        (select count(distinct artist) from \"lastfm\".\"main\".\"raw_scrobbles\") as raw_artists,\n        (select count(*) from \"lastfm\".\"main\".\"dim_artist_genre\") as dim_artists\n)\nwhere raw_artists != dim_artists", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026