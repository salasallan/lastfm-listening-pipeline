_plays", "compiled": true, "compiled_code": "-- The most recent plays (local time), with genre. This is the only play-level table that is\n-- published; the window size can be changed with the recent_plays_limit variable.\nselect\n    p.played_at_local,\n    p.artist,\n    p.track,\n    p.album,\n    g.genre,\n    g.genre_family\nfrom \"lastfm\".\"main\".\"stg_plays\" p\njoin \"lastfm\".\"main\".\"dim_artist_genre\" g on g.artist = p.artist\norder by p.played_at_utc desc\nlimit 100", "relation_name": "\"lastfm\".\"main\".\"mart_recent_plays\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-13T23:17:56.382487Z", "completed_at": "2026-11-13T23:17:56.384903Z"}, {"name": "execute", "started_at": "2026-11-13T23:17:56.385280Z", "completed_at": "2026-11-13T23:17:56.428891Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0483241081237793, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.lastfm_pipeline.marts_grain_is_unique", "compiled": true, "compiled_code": "-- Fails if any mart has duplicate rows at its declared grain.\nselect 'artist_daily' as mart, play_date::varchar as k1, artist as k2, '' as k3\nfrom \"lastfm\".\"main\".\"mart_artist_daily\"\ngroup by play_date, artist\nhaving count(*) > 1\n\nunion all\n\nselect 'album_daily', play_date::varchar, artist, album\nfrom \"lastfm\".\"main\".\"mart_album_daily\"\ngroup by play_date, artist, album\nhaving count(*) > 1\n\nunion all\n\nselect 'track_daily', play_date::varchar, artist, track\nfrom \"lastfm\".\"main\".\"mart_track_daily\"\ngroup by play_date, artist, track\nhaving count(*) > 1", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-13T23:17:56.432823Z", "completed_at": "2026-11-13T23:17:56.436051Z"}, {"name": "execute", "started_at": "2026-11-13T23:17:56.436428Z", "completed_at": "2026-11-13T2