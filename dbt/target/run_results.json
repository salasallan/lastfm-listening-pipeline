sts can share album names.\nselect\n    cast(played_at_local as date) as play_date,\n    artist,\n    album,\n    count(*) as plays\nfrom \"lastfm\".\"main\".\"stg_plays\"\nwhere album is not null\ngroup by 1, 2, 3", "relation_name": "\"lastfm\".\"main\".\"mart_album_daily\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-18T01:40:11.684589Z", "completed_at": "2026-11-18T01:40:11.686747Z"}, {"name": "execute", "started_at": "2026-11-18T01:40:11.687146Z", "completed_at": "2026-11-18T01:40:11.816661Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.1336214542388916, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.lastfm_pipeline.mart_track_daily", "compiled": true, "compiled_code": "-- Plays per artist + track per day.\nselect\n    cast(played_at_local as date) as play_date,\n    artist,\n    track,\n    count(*) as plays\nfrom \"lastfm\".\"main\".\"stg_plays\"\ngroup by 1, 2, 3", "relation_name": "\"lastfm\".\"main\".\"mart_track_daily\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-18T01:40:11.820618Z", "completed_at": "2026-11-18T01:40:11.824149Z"}, {"name": "execute", "started_at": "2026-11-18T01:40:11.824555Z", "completed_at": "2026-11-18T01:40:11.902232Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.08290314674377441, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.lastfm_pipeline.dim_artist_genre", "compiled": true, "compiled_code": "-- One row per artist with a single genre: the highest-weighted tag that appears in genre_mapping.\n-- 'unknown' = no tags at all; 'other' = has tags, but none is in the mapping.\nwith artists as (\n    select distinct artist\n    from \"lastfm\".\"main\".\"raw_scrobbles\"\n),\n\nartists_with_tags as (\n    select distinct artist\n    from \"lastfm\".\"main\".\"stg_artist_tags\"\n),\n\nmapped_tags as (\n    select\n        t.artist,\n        m.genre,\n        m.genre_family,\n        row_number() over (\n            partition by t.artist\n            order by t.tag_count desc, m.genre\n        ) as rn\n    from \"lastfm\".\"main\".\"stg_artist_tags\" t\n    join \"lastfm\".\"main\".\"genre_mapping\" m\n        on t.tag = lower(m.tag)\n)\n\nselect\n    a.artist,\n    case\n        when b.genre is not null then b.genre\n        when w.artist is not null then 'other'\n        else 'unknown'\n    end as genre,\n    case\n        when b.genre_family is not null then b.genre_family\n        when w.artist is not null then 'Other'\n        else 'Unknown'\n    end as genre_family\nfrom artists a\nleft join (select * from mapped_tags where rn = 1) b on b.artist = a.artist\nleft join artists_with_tags w on w.artist = a.artist", "relation_name": "\"lastfm\".\"main\".\"dim_artist_genre\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-18T01:40:11.906203Z", "completed_at": "2026-11-18T01:40:11.912797Z"}, {"name": "execute", "started_at": "2026-11-18T01:40:11.913203Z", "completed_at": "2026-11-18T01:40:11.920138Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.01581430435180664, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.lastfm_pipeline.not_null_mart_album_daily_album.9618172ce8", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect album\nfrom \"lastfm\".\"main\".\"mart_album_daily\"\nwhere album is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-18T01:40:11.924195Z", "completed_at": "2026-11-18T01:40:11.932329Z"}, {"name": "execute", "started_at": "2026-11-18T01:40:11.932748Z", "completed_at": "2026-11-18T01:40:11.939578Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.017