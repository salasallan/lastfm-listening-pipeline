ent_plays", "compiled": true, "compiled_code": "-- The most recent plays (local time), with genre. This is the only play-level table that is\n-- published; the window size can be changed with the recent_plays_limit variable.\nselect\n    p.played_at_local,\n    p.artist,\n    p.track,\n    p.album,\n    g.genre,\n    g.genre_family\nfrom \"lastfm\".\"main\".\"stg_plays\" p\njoin \"lastfm\".\"main\".\"dim_artist_genre\" g on g.artist = p.artist\norder by p.played_at_utc desc\nlimit 100", "relation_name": "\"lastfm\".\"main\".\"mart_recent_plays\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-13T23:30:19.640217Z", "completed_at": "2026-11-13T23:30:19.642908Z"}, {"name": "execute", "started_at": "2026-11-13T23:30:19.643310Z", "completed_at": "2026-11-13T23:30:19.686322Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04803752899169922, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.lastfm_pipeline.marts_grain_is_unique", "compiled": true, "compiled_code": "-- Fails if any mart has duplicate rows at its declared grain.\nselect 'artist_daily' as mart, play_date::varchar as k1, artist as k2, '' as k3\nfrom \"lastfm\".\"main\".\"mart_artist_daily\"\ngroup by play_date, artist\nhaving count(*) > 1\n\nunion all\n\nselect 'album_daily', play_date::varchar, artist, album\nfrom \"lastfm\".\"main\".\"mart_album_daily\"\ngroup by play_date, artist, album\nhaving count(*) > 1\n\nunion all\n\nselect 'track_daily', play_date::varchar, artist, track\nfrom \"lastfm\".\"main\".\"mart_track_daily\"\ngroup by play_date, artist, track\nhaving count(*) > 1", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-13T23:30:19.690917Z", "completed_at": "2026-11-13T23:30:19.694251Z"}, {"name": "execute", "started_at": "2026-11-13T23:30:19.694642Z", "completed_at": "2026-11-13T23:30:19.901475Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.21272754669189453, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.lastfm_pipeline.marts_reconcile_with_staging", "compiled": true, "compiled_code": "-- Fails if a mart's total plays differ from what staging says it should be.\nwith checks as (\n    select 'artist_daily' as mart,\n           (select sum(plays) from \"lastfm\".\"main\".\"mart_artist_daily\") as mart_plays,\n           (select count(*) from \"lastfm\".\"main\".\"stg_plays\") as expected_plays\n    union all\n    select 'track_daily',\n           (select sum(plays) from \"lastfm\".\"main\".\"mart_track_daily\"),\n           (select count(*) from \"lastfm\".\"main\".\"stg_plays\")\n    union all\n    select 'album_daily',\n           (select sum(plays) from \"lastfm\".\"main\".\"mart_album_daily\"),\n           (select count(*) from \"lastfm\".\"main\".\"stg_plays\" where album is not null)\n)\nselect * from checks where mart_plays != expected_plays", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-13T23:30:19.905591Z", "completed_at": "2026-11-13T23:30:19.912097Z"}, {"name": "execute", "started_at": "2026-11-13T23:30:19.912488Z", "completed_at": "2026-11-13T23:30:19.919422Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.015789031982421875, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.lastfm_pipeline.not_null_mart_artist_daily_artist.44b63de903", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect artist\nfrom \"lastfm\".\"main\".\"mart_artist_daily\"\nwhere artist is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-13T23:30:19.923737Z", "completed_at": "2026-11-13T23:30:19.931161Z"}, {"name": "execute", "started_