    nullif(json_extract_string(payload, '$.album.mbid'), '')     as album_mbid,
    nullif(json_extract_string(payload, '$.mbid'), '')           as track_mbid,
    json_extract_string(payload, '$.url')                        as track_url,
    ingested_at
from "lastfm"."main"."raw_scrobbles"
  );

