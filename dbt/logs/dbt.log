  create view "lastfm"."main"."stg_plays__dbt_tmp" as (
    -- Staging model: one row per play, typed and flattened from raw_scrobbles.
select
    lastfm_user,
    uts                                                          as played_at_uts,
    make_timestamp(uts * 1000000)                                as played_at_utc,
