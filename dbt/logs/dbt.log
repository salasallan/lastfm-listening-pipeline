    p.played_at_local,
    p.artist,
    p.track,
    p.album,
    g.genre,
    g.genre_family
from "lastfm"."main"."stg_plays" p
join "lastfm"."main"."dim_artist_genre" g on g.artist = p.artist
order by p.played_at_utc desc
limit 100
    );
    
  
